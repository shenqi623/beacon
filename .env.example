# 复制为 .env 仅用于本地遗留脚本（如 pnpm get-token）。
# 正式桌面端请在应用内「配置」填写，不要依赖本文件。
# .env 已加入 .gitignore，不会提交到仓库。

# OAuth 客户端需在 Google Cloud Console 中创建，类型选择「桌面应用」。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 运行 pnpm get-token 可写入（遗留；正式授权请用应用内「授权登录」）
GOOGLE_REFRESH_TOKEN=

# 访问 Google 需要代理时填写
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
